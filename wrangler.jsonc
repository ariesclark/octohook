{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "better-github-discord-webhook",
	"main": "src/index.ts",
	"compatibility_date": "2026-08-16",
	"upload_source_maps": true,
	"routes": [
		{
			"pattern": "bdgw.aries.fyi",
			"custom_domain": true
		}
	],
	"queues": {
		"consumers": [
			{
				"queue": "bdgw-webhooks"
			}
		],
		"producers": [
			{
				"binding": "WEBHOOK_QUEUE",
				"queue": "bdgw-webhooks"
			}
		]
	}
}