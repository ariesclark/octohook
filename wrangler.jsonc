{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "octohook",
	"main": "src/index.ts",
	"compatibility_date": "2026-08-16",
	"upload_source_maps": true,
	"observability": {
		"enabled": true,
		"traces": {
			"enabled": true
		}
	},
	"routes": [
		{
			"pattern": "octohook.aries.fyi",
			"custom_domain": true
		}
	],
	"durable_objects": {
		"bindings": [
			{
				"name": "CHANNEL",
				"class_name": "Channel"
			}
		]
	},
	"exports": {
		"Channel": {
			"type": "durable-object",
			"storage": "sqlite"
		}
	}
}
