  "push.branch": "created branch {$branch}",
  "push.tag": "pushed tag {$tag}",
  "delete.branch": "deleted branch {$ref}",
  "delete.tag": "deleted tag {$ref}",
  "star.added": "starred {$repository}",
  "star.removed": "unstarred {$repository}"
