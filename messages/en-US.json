{
  "run.jobs": ".input {$count :number}\n.match $count\none {{{$count} job}}\n*   {{{$count} jobs}}",
  "run.failed": ".input {$count :number}\n.match $count\n*   {{{$count} failed}}",
  "run.running": ".input {$count :number}\n.match $count\n*   {{{$count} running}}",
  "run.passed": ".input {$count :number}\n.match $count\n*   {{{$count} passed}}",
  "run.skipped": ".input {$count :number}\n.match $count\n*   {{{$count} skipped}}",
  "run.deploying": ".input {$count :number}\n.match $count\n*   {{{$count} deploying}}",
  "run.progress": "{$done :number} of {$total :number}",
  "run.checks": "checks",
  "annotation.more": ".input {$count :number}\n.match $count\none {{and one more}}\n*   {{and {$count} more}}",
  "annotation.repeats": "\u00d7{$count :number}",
  "duration.seconds": "{$seconds :number}s",
  "duration.minutes": "{$minutes :number}m {$seconds :number}s",
  "check.running": "is running",
  "check.success": "passed",
  "check.failure": "failed",
  "check.cancelled": "was cancelled",
  "check.timed_out": "timed out",
  "check.action_required": "needs action",
