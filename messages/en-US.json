  "deployment.pending": "queued a deploy to",
  "deployment.inactive": "took down",
  "trigger.schedule": "scheduled",
  "trigger.workflow_dispatch": "manual",
  "trigger.pull_request": "pull request",
  "trigger.repository_dispatch": "dispatch",
  "deploy.success": "deployed",
  "deploy.in_progress": "deploying",
  "deploy.queued": "queued a deploy of",
  "deploy.pending": "queued a deploy of",
  "deploy.failure": "failed to deploy",
  "deploy.error": "errored deploying",
  "deploy.inactive": "took down",
  "star.count": ".input {$count :number}\n.match $count\none {{{$count} star}}\n*   {{{$count} stars}}",
  "push.headline": "pushed {$commits} to {$branch}",
  "push.commits": ".input {$count :number}\n.match $count\none {{{$count} new commit}}\n*   {{{$count} new commits}}",
